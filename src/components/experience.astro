---
import { experience } from '../data/experinceData';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const data = experience[lang];

const companies = [
  { key: 'srs', data: data.srs, icon: 'https://d3ecg82tkkq2g3.cloudfront.net/Image/LOGOWEB.webp', color: 'blue', number: '01' },
  { key: 'fundes', data: data.fundes, icon: '🏛️', color: 'white', number: '02' },
  { key: 'universidad', data: data.universidad, icon: 'https://www.relacionespublicas.una.ac.cr/images/servicios/Logo-UNA-Rojo_FondoTransparente.png', color: 'red', number: '03' },
  { key: 'freelance', data: data.freelance, icon: '💼', color: 'yellow', number: '04' }
];

const colorClasses = {
  blue:   { border: 'border-blue-500',   text: 'text-blue-400',   gradient: 'from-blue-400 to-cyan-400',   glow: 'shadow-blue-500/30' },
  white:  { border: 'border-white',      text: 'text-white',      gradient: 'from-white to-gray-400',      glow: 'shadow-white/20' },
  red:    { border: 'border-red-500',    text: 'text-red-400',    gradient: 'from-red-400 to-rose-400',    glow: 'shadow-red-500/30' },
  yellow: { border: 'border-yellow-500', text: 'text-yellow-400', gradient: 'from-yellow-400 to-orange-400', glow: 'shadow-yellow-500/30' }
};
---

<section
  id="experience"
  data-gsap="experience-section"
  class="experience-section relative bg-gradient-to-b from-slate-900 to-slate-800 overflow-hidden"
>
  <!-- Título sticky arriba (solo desktop, opcional) -->
  <div class="experience-title-wrap absolute top-0 left-0 right-0 z-20 pt-8 pointer-events-none">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-bold inline-block">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-400 via-pink-400 to-yellow-400">
          {data.title}
        </span>
      </h2>
      <div class="w-24 h-1 bg-gradient-to-r from-purple-400 to-pink-400 mx-auto rounded-full mt-3"></div>
    </div>
  </div>

  <!-- Track horizontal (en mobile cae en columna por CSS) -->
  <div data-experience-track class="experience-track">
    {companies.map((company, i) => {
      const c = colorClasses[company.color as keyof typeof colorClasses];
      const projectsCount = company.data.projects.length;
      const gridCols =
        projectsCount === 1 ? 'grid-cols-1 max-w-2xl' :
        projectsCount === 2 ? 'md:grid-cols-2 max-w-5xl' :
        'md:grid-cols-2 lg:grid-cols-3 max-w-7xl';

      return (
        <article
          data-experience-panel
          data-panel-index={i}
          class="experience-panel"
        >
          <!-- Número gigante de fondo -->
          <span
            data-panel-number
            class={`panel-bg-number bg-clip-text text-transparent bg-gradient-to-br ${c.gradient}`}
            aria-hidden="true"
          >
            {company.number}
          </span>

          <div class="panel-content">
            <!-- Header de empresa -->
            <header data-panel-header class="flex items-center gap-5 mb-10">
              <div class={`w-20 h-20 rounded-full bg-white/5 flex items-center justify-center border-2 ${c.border} overflow-hidden shadow-2xl ${c.glow}`}>
                {company.icon.startsWith('http') ? (
                  <img
                    src={company.icon}
                    alt={company.data.title}
                    class="w-full h-full object-contain p-2 pointer-events-none"
                  />
                ) : (
                  <span class="text-4xl">{company.icon}</span>
                )}
              </div>
              <div>
                <p class="text-xs uppercase tracking-widest text-gray-500 mb-1">
                  {lang === 'es' ? 'Empresa' : 'Company'} · {company.number}
                </p>
                <h3 class={`text-2xl md:text-4xl font-bold ${c.text}`}>
                  {company.data.title}
                </h3>
              </div>
            </header>

            <!-- Grid de proyectos -->
            <div class={`grid gap-6 w-full mx-auto ${gridCols}`}>
              {company.data.projects.map((project, projectIndex) => (
                <div
                  data-project-card
                  id={`project-${company.key}-${projectIndex}`}
                  class="project-card bg-slate-800/60 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:border-purple-400/50 transition-all duration-300 hover:shadow-xl hover:shadow-purple-500/20 group"
                >
                  <h4 class="text-xl font-bold text-white mb-3 group-hover:text-purple-400 transition-colors">
                    {project.name}
                  </h4>
                  <p class="text-gray-400 text-sm mb-4 leading-relaxed">
                    {project.description}
                  </p>

                  <div class="mb-4">
                    <h5 class="text-xs font-bold text-blue-400 uppercase mb-2">
                      {lang === 'es' ? 'Tecnologías' : 'Technologies'}
                    </h5>
                    <div class="flex flex-wrap gap-2">
                      {project.technologies.map((tech) => (
                        <span class="px-3 py-1 text-xs rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div class="mb-4">
                    <h5 class="text-xs font-bold text-purple-400 uppercase mb-1">
                      {lang === 'es' ? 'Mi rol' : 'My role'}
                    </h5>
                    <p class="text-gray-400 text-sm leading-relaxed">{project.role}</p>
                  </div>

                  <div class="mb-4">
                    <h5 class="text-xs font-bold text-yellow-400 uppercase mb-1">
                      {lang === 'es' ? 'Desafío' : 'Challenge'}
                    </h5>
                    <p class="text-gray-400 text-sm leading-relaxed">{project.challenge}</p>
                  </div>

                  <div class="border-t border-white/10 pt-4">
                    <h5 class="text-xs font-bold text-green-400 uppercase mb-1">
                      {lang === 'es' ? 'Impacto' : 'Impact'}
                    </h5>
                    <p class="text-gray-400 text-sm leading-relaxed">{project.impact}</p>
                  </div>

                  {project.Url && (
                    <div class="mt-4">
                      <a href={project.Url} target="_blank" rel="noopener noreferrer" class="text-sm text-cyan-400 hover:underline inline-flex items-center gap-1">
                        {lang === 'es' ? 'Visitar sitio' : 'Visit site'} →
                      </a>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Barra de progreso (solo visible en desktop) -->
  <div class="experience-progress-wrap absolute bottom-6 left-1/2 -translate-x-1/2 w-64 h-1 bg-white/10 rounded-full overflow-hidden hidden lg:block z-30">
    <div data-experience-progress class="h-full bg-gradient-to-r from-purple-400 via-pink-400 to-yellow-400 origin-left scale-x-0"></div>
  </div>
</section>

<style>
  /* ─────── DESKTOP: horizontal scroll ─────── */
  .experience-section {
    height: 100vh;
  }

  .experience-track {
    display: flex;
    flex-direction: row;
    height: 100%;
    will-change: transform;
  }

  .experience-panel {
    flex-shrink: 0;
    width: 100vw;
    height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 4rem 4rem;
    overflow: hidden;
  }

  .panel-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
  }

  .panel-bg-number {
    position: absolute;
    bottom: -3rem;
    right: -2rem;
    font-size: clamp(20rem, 40vw, 40rem);
    font-weight: 900;
    line-height: 1;
    opacity: 0.06;
    pointer-events: none;
    z-index: 1;
    user-select: none;
  }

  .project-card {
    will-change: transform, opacity;
  }

  /* ─────── MOBILE / TABLET: vertical stack ─────── */
  @media (max-width: 1023px) {
    .experience-section {
      height: auto;
      padding: 4rem 0 2rem;
    }
    .experience-title-wrap {
      position: relative;
      padding-top: 1rem;
      padding-bottom: 2rem;
    }
    .experience-track {
      flex-direction: column;
      height: auto;
      transform: none !important;
    }
    .experience-panel {
      width: 100%;
      height: auto;
      min-height: auto;
      padding: 3rem 1.5rem;
    }
    .panel-bg-number {
      font-size: 14rem;
      bottom: -1rem;
      right: -1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-track { transform: none !important; }
  }
</style>