---
import { heroData } from "../data/heroData";

interface Props {
  lang?: "es" | "en";
}

const { lang = "en" } = Astro.props;
const data = heroData[lang];
const Url: string = import.meta.env.BUCKET_URL || '';
const ingenieroImg: string = "/Image/ingeniero.png?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV8xZGUzNTlkZi05MWEzLTQzMzMtOWVhZS00YjExZDE4YTZmYjAiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJJbWcvSW1hZ2UvaW5nZW5pZXJvLnBuZyIsImlhdCI6MTc3NTQ1NjY3OCwiZXhwIjoyMDkwODE2Njc4fQ.B8i-CabMgex-LgokhWT1pY7AwMpByJbpI58aeD7Y4UY";
---

<section
  id="hero"
  class="min-h-screen bg-gradient-to-b from-slate-900 to-slate-800 text-white relative overflow-hidden"
>
  <!-- Blobs animados -->
  <div id="hero-bg-overlay" class="absolute inset-0 pointer-events-none">
    <div data-blob="1" class="hero-blob bg-purple-500 top-20 left-10"></div>
    <div data-blob="2" class="hero-blob bg-yellow-500 top-40 right-10 animation-delay-2000"></div>
    <div data-blob="3" class="hero-blob bg-pink-500 -bottom-8 left-20 animation-delay-4000"></div>
  </div>

  <div class="container mx-auto px-6 py-20 relative z-10">
    <div id="hero-header" class="mb-16 pt-10">
      <div class="flex flex-col md:flex-row items-center justify-center gap-12 max-w-7xl mx-auto">

        <div id="hero-image-container" class="w-64 h-64 md:w-80 md:h-80 flex-shrink-0 pointer-events-none will-change-transform">
          <img
            src={`${Url}${ingenieroImg}`}
            alt="Brayan Ordoñez"
            class="w-full h-full object-contain drop-shadow-2xl"
            draggable="false"
          />
        </div>

        <div class="flex-1 text-center md:text-left">
          <h1 id="hero-name" class="text-4xl md:text-6xl lg:text-7xl font-bold mb-10 leading-tight md:leading-snug lg:leading-snug bg-clip-text text-transparent bg-gradient-to-r from-purple-400 via-pink-400 to-yellow-400">
            {data.name}
          </h1>
          <h2 id="hero-title" class="text-xl md:text-3xl lg:text-4xl font-semibold mb-4 text-purple-200">
            {data.title}
          </h2>
          <p id="hero-tagline" class="text-base md:text-lg lg:text-xl text-gray-300 leading-relaxed">
            "{data.tagline}"
          </p>
        </div>
      </div>
    </div>

    <div id="hero-content-text" class="max-w-4xl mx-auto">
      <div class="bg-white/5 backdrop-blur-lg rounded-2xl p-8 md:p-12 shadow-2xl border border-white/10">
        <p class="text-lg md:text-xl text-gray-200 leading-relaxed mb-6">
          {data.sections.aboutMe.content}
        </p>
        <p class="text-lg md:text-xl text-gray-200 leading-relaxed mb-6">
          {data.sections.motivation.content}
        </p>
        <p class="text-lg md:text-xl text-gray-200 leading-relaxed">
          {
            lang === "es"
              ? `Mis valores fundamentales son ${data.sections.values.items.join(", ").toLowerCase()}.`
              : `My core values are ${data.sections.values.items.join(", ").toLowerCase()}.`
          }
        </p>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div
      id="hero-scroll-indicator"
      class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 translate-y-4 pointer-events-none"
    >
      <span class="text-xs uppercase tracking-widest text-gray-400">
        {lang === 'es' ? 'Scroll' : 'Scroll'}
      </span>
      <svg data-arrow class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-blob {
    position: absolute;
    width: 18rem;
    height: 18rem;
    border-radius: 9999px;
    mix-blend-mode: multiply;
    filter: blur(48px);
    opacity: 0.5;
    animation: blob 12s infinite;
    will-change: transform;
  }

  @keyframes blob {
    0%   { transform: translate(0px, 0px) scale(1); }
    33%  { transform: translate(30px, -50px) scale(1.1); }
    66%  { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  .animation-delay-2000 { animation-delay: 2s; }
  .animation-delay-4000 { animation-delay: 4s; }

  /* SplitType: las palabras no se rompen entre líneas */
  #hero-name :global(.word) { display: inline-block; }
  #hero-name :global(.char) { display: inline-block; will-change: transform, opacity; }
</style>